# ==================== App ====================
ENV=development
LOG_LEVEL=DEBUG
APP_WORKERS=1
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==================== LLM ====================
LLM_PROVIDER_SOURCE=env
LLM_PROVIDER=deepseek
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_DEFAULT_MODEL=deepseek-chat
OPENAI_FAST_MODEL=deepseek-chat

# ==================== Embedding (Ollama / Qwen) ====================
EMBEDDING_ENABLED=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIM=1024

# ==================== Rerank (Ollama / Qwen3 Reranker) ====================
RERANK_ENABLED=true
RERANK_API_KEY=
RERANK_BASE_URL=http://localhost:11434
RERANK_MODEL=dengcao/Qwen3-Reranker-4B:Q4_K_M
RERANK_MAX_CONCURRENCY=1

# ==================== PostgreSQL ====================
POSTGRES_DSN=postgresql+asyncpg://myagent:yourpassword@localhost:5432/myagent

# ==================== Neo4j ====================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=yourpassword

# ==================== Redis ====================
REDIS_URL=redis://:yourpassword@localhost:6379/0

# ==================== Milvus ====================
MILVUS_URI=http://localhost:19530
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_DB_NAME=lightrag

# ==================== Game DB ====================
GAME_DB_DSN=postgresql+asyncpg://readonly:password@game-db-host/gamedb
GAME_DATA_SOURCE=robotgateway
ROBOTGATEWAY_BASE_URL=http://localhost:9000
ROBOTGATEWAY_SNAPSHOT_API_KEY=
ROBOTGATEWAY_SNAPSHOT_TIMEOUT_SECONDS=10

# ==================== RAG ====================
RAG_DEFAULT_STRATEGY=hybrid
RAG_WORKING_DIR=/app/rag_storage
GATHER_CONTEXT_ENABLE_DYNAMIC_RAG=false
LIGHTRAG_VECTOR_COSINE_THRESHOLD=0.5
LIGHTRAG_CHUNK_TOP_K=50
RAG_EXACT_MATCH_ENABLED=true
RAG_EXACT_MATCH_TOP_K=5

# ==================== 调度 ====================
MAX_CONCURRENT_ANALYSES=20
OFFLINE_TRIGGER_MINUTES=5

# ==================== RobotGateway Callback ====================
ROBOTGATEWAY_CALLBACK_URL=http://localhost:9000/callbacks/analysis
ROBOTGATEWAY_CALLBACK_API_KEY=
ROBOTGATEWAY_CALLBACK_TIMEOUT_SECONDS=10

# ==================== LLM Gateway shared / v1 runtime ====================
# Keep test/development credentials outside source control.
LLM_GATEWAY_V1_ENABLED=true
LLM_GATEWAY_V2_ENABLED=false
LLM_GATEWAY_APP_SECRETS={"gateway-to-llm":"<gateway-to-myagent-secret>"}
LLM_GATEWAY_APP_GATEWAYS={"gateway-to-llm":["gateway-01"]}
LLM_GATEWAY_APP_TENANTS={"gateway-01":"00000000-0000-0000-0000-000000000001"}
LLM_GATEWAY_TIMESTAMP_TOLERANCE_MS=300000
LLM_GATEWAY_IDEMPOTENCY_TTL_SECONDS=86400
LLM_GATEWAY_DECISION_URL=http://<gateway-host>:<port>/api/v1/hosting/llm/decision
LLM_GATEWAY_DECISION_APP_ID=llm-to-gateway
LLM_GATEWAY_DECISION_APP_SECRET=<llm-to-gateway-secret>
LLM_GATEWAY_DECISION_TIMEOUT_SECONDS=10
LLM_GATEWAY_DECISION_MAX_RETRIES=1
LLM_GATEWAY_EVENT_WORKER_ENABLED=true
LLM_GATEWAY_EVENT_STREAM_KEY=llm-gateway:events
LLM_GATEWAY_EVENT_CONSUMER_GROUP=myagent2
LLM_GATEWAY_EVENT_WORKER_BLOCK_MS=1000
LLM_GATEWAY_EVENT_RETRY_IDLE_MS=30000

# ==================== LLM Gateway v2 runtime ====================
LLM_GATEWAY_V2_MAX_EVENT_BATCH_SIZE=100
LLM_GATEWAY_V2_MAX_DECISION_TTL_MS=30000
LLM_GATEWAY_V2_EVENT_MAX_ATTEMPTS=5
LLM_GATEWAY_V2_DECISION_MAX_ATTEMPTS=5
LLM_GATEWAY_V2_RETRY_BASE_MS=1000
LLM_GATEWAY_V2_RETRY_MAX_MS=300000
LLM_GATEWAY_V2_CLAIM_TTL_MS=30000
LLM_GATEWAY_V2_POLL_MS=250
LLM_GATEWAY_V2_EVENT_MAX_PARALLELISM=4
LLM_GATEWAY_V2_DECISION_MAX_PARALLELISM=4
LLM_GATEWAY_V2_SHUTDOWN_GRACE_SECONDS=10
LLM_GATEWAY_V2_READINESS_TIMEOUT_SECONDS=3
LLM_GATEWAY_V2_READINESS_CACHE_SECONDS=5

# ==================== Token 配额 ====================
DEFAULT_MONTHLY_TOKENS=40000000
QUOTA_WARNING_THRESHOLD=0.8

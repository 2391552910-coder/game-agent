# ==================== App ====================
ENV=development
LOG_LEVEL=DEBUG
APP_WORKERS=1
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==================== LLM ====================
LLM_PROVIDER_SOURCE=env
LLM_PROVIDER=deepseek
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_DEFAULT_MODEL=deepseek-chat
OPENAI_FAST_MODEL=deepseek-chat

# ==================== Embedding (Ollama / Qwen) ====================
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIM=1024

# ==================== Rerank (Ollama / Qwen3 Reranker) ====================
RERANK_ENABLED=true
RERANK_API_KEY=
RERANK_BASE_URL=http://localhost:11434
RERANK_MODEL=dengcao/Qwen3-Reranker-4B:Q4_K_M
RERANK_MAX_CONCURRENCY=1

# ==================== PostgreSQL ====================
POSTGRES_DSN=postgresql+asyncpg://myagent:yourpassword@localhost:5432/myagent

# ==================== Neo4j ====================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=yourpassword

# ==================== Redis ====================
REDIS_URL=redis://:yourpassword@localhost:6379/0

# ==================== Milvus ====================
MILVUS_URI=http://localhost:19530
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_DB_NAME=lightrag

# ==================== Game DB ====================
GAME_DB_DSN=postgresql+asyncpg://readonly:password@game-db-host/gamedb
GAME_DATA_SOURCE=robotgateway
ROBOTGATEWAY_BASE_URL=http://localhost:9000
ROBOTGATEWAY_SNAPSHOT_API_KEY=
ROBOTGATEWAY_SNAPSHOT_TIMEOUT_SECONDS=10

# ==================== RAG ====================
RAG_DEFAULT_STRATEGY=hybrid
RAG_WORKING_DIR=/app/rag_storage
GATHER_CONTEXT_ENABLE_DYNAMIC_RAG=false
LIGHTRAG_VECTOR_COSINE_THRESHOLD=0.5
LIGHTRAG_CHUNK_TOP_K=50
RAG_EXACT_MATCH_ENABLED=true
RAG_EXACT_MATCH_TOP_K=5

# ==================== 调度 ====================
MAX_CONCURRENT_ANALYSES=20
OFFLINE_TRIGGER_MINUTES=5

# ==================== RobotGateway Callback ====================
ROBOTGATEWAY_CALLBACK_URL=http://localhost:9000/callbacks/analysis
ROBOTGATEWAY_CALLBACK_API_KEY=
ROBOTGATEWAY_CALLBACK_TIMEOUT_SECONDS=10

# ==================== Token 配额 ====================
DEFAULT_MONTHLY_TOKENS=40000000
QUOTA_WARNING_THRESHOLD=0.8

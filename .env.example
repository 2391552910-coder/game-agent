# ==================== App ====================
ENV=development
LOG_LEVEL=DEBUG
APP_WORKERS=1
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ==================== LLM ====================
LLM_PROVIDER=deepseek
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_DEFAULT_MODEL=deepseek-chat
OPENAI_FAST_MODEL=deepseek-chat

# ==================== Embedding (DashScope / Qwen) ====================
EMBEDDING_API_KEY=sk-your-dashscope-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ==================== Rerank (DashScope / Qwen gte-rerank-v2) ====================
RERANK_API_KEY=sk-your-dashscope-key
RERANK_MODEL=gte-rerank-v2

# ==================== PostgreSQL ====================
POSTGRES_DSN=postgresql+asyncpg://myagent:yourpassword@localhost:5432/myagent

# ==================== Neo4j ====================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=yourpassword

# ==================== Redis ====================
REDIS_URL=redis://:yourpassword@localhost:6379/0

# ==================== Milvus ====================
MILVUS_URI=http://localhost:19530
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_DB_NAME=lightrag

# ==================== Game DB ====================
GAME_DB_DSN=postgresql+asyncpg://readonly:password@game-db-host/gamedb

# ==================== RAG ====================
RAG_DEFAULT_STRATEGY=hybrid
RAG_WORKING_DIR=/app/rag_storage

# ==================== 调度 ====================
MAX_CONCURRENT_ANALYSES=20
OFFLINE_TRIGGER_MINUTES=5

# ==================== Token 配额 ====================
DEFAULT_MONTHLY_TOKENS=40000000
QUOTA_WARNING_THRESHOLD=0.8
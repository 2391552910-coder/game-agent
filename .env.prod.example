# Copy to .env.prod and replace every placeholder before starting Compose.

# Compose-level credentials and image settings
POSTGRES_USER=myagent
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=myagent
REDIS_PASSWORD=replace-with-a-long-random-password
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=replace-with-a-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_MODELS=qwen3-embedding:4b,dengcao/Qwen3-Reranker-4B:Q4_K_M
OLLAMA_HEALTH_TIMEOUT_SECONDS=1200
MYAGENT_API_BIND_ADDRESS=127.0.0.1
MYAGENT_API_PORT=8000

# Application
ENV=production
LOG_LEVEL=INFO
APP_WORKERS=1
CORS_ALLOWED_ORIGINS=[]

# OpenAI-compatible decision LLM
LLM_PROVIDER_SOURCE=env
LLM_PROVIDER=deepseek
OPENAI_API_KEY=replace-with-llm-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_DEFAULT_MODEL=replace-with-default-model
OPENAI_FAST_MODEL=replace-with-fast-model

# Local Ollama embedding and reranking
EMBEDDING_ENABLED=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIM=1024
RERANK_ENABLED=true
RERANK_API_KEY=
RERANK_BASE_URL=http://ollama:11434
RERANK_MODEL=dengcao/Qwen3-Reranker-4B:Q4_K_M
RERANK_MAX_CONCURRENCY=1

# Internal service URLs
POSTGRES_DSN=postgresql+asyncpg://myagent:replace-with-a-long-random-password@postgres:5432/myagent
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=40
POSTGRES_EVENT_ADMISSION_POOL_SIZE=16
POSTGRES_EVENT_ADMISSION_MAX_OVERFLOW=16
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379/0
MILVUS_URI=http://milvus:19530
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_DB_NAME=lightrag

# RAG
RAG_DEFAULT_STRATEGY=hybrid
RAG_WORKING_DIR=/app/rag_storage
GATHER_CONTEXT_ENABLE_DYNAMIC_RAG=false
LLM_GATEWAY_V2_RAG_MODE=hybrid
RAG_EXACT_MATCH_ENABLED=true
RAG_EXACT_MATCH_TOP_K=5

# Gateway v2 HMAC identities. Use a real existing tenant UUID.
LLM_GATEWAY_V1_ENABLED=false
LLM_GATEWAY_V2_ENABLED=true
LLM_GATEWAY_APP_SECRETS={"gateway-events-to-myagent":"replace-with-inbound-secret"}
LLM_GATEWAY_APP_GATEWAYS={"gateway-events-to-myagent":["gateway-prod-01"]}
LLM_GATEWAY_APP_TENANTS={"gateway-prod-01":"00000000-0000-0000-0000-000000000000"}
LLM_GATEWAY_TIMESTAMP_TOLERANCE_MS=300000
LLM_GATEWAY_DECISION_URL=http://replace-with-gateway-host:port/api/v1/hosting/llm/decision
LLM_GATEWAY_DECISION_APP_ID=myagent-decisions-to-gateway
LLM_GATEWAY_DECISION_APP_SECRET=replace-with-outbound-secret
LLM_GATEWAY_DECISION_TIMEOUT_SECONDS=10

# Optional game snapshot and legacy callback integrations
# Leave these variables unset unless the legacy snapshot/callback chain is enabled.

# One-shot RAG import settings
RAG_IMPORT_INPUT=/app/game_docs/数据导入文件夹
RAG_IMPORT_BATCH_SIZE=25
RAG_IMPORT_LIMIT=0
RAG_IMPORT_WORKSPACE=
